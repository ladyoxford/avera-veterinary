NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://avera:change-me@localhost:5432/avera
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
TOTP_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_LOCAL_DEVELOPMENT_AUTH=true
ENABLE_DEMO_DATA_GENERATOR=false
DATABASE_SSL=false
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=1048576
ENABLE_DEVELOPMENT_RESET_LINK_PREVIEW=false
# Required only by `npm run seed:development`; never set these in production.
# Development identities: owner@avera.test and admin@avera.test.
DEVELOPMENT_PLATFORM_OWNER_PASSWORD=
DEVELOPMENT_CLINIC_ADMIN_PASSWORD=
DEVELOPMENT_DEMO_ADMIN_PASSWORD=
# Paystack secrets stay on the backend. Leave blank to disable checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Preferred checkout callback and three-letter settlement currency.
PAYSTACK_CALLBACK_URL=
PAYSTACK_CURRENCY=NGN
# Legacy callback fallback; prefer PAYSTACK_CALLBACK_URL for new deployments.
APP_PAYMENT_CALLBACK_URL=
APP_DEEP_LINK_SCHEME=avera
PAYSTACK_STARTER_MONTHLY_PLAN_CODE=
PAYSTACK_STARTER_ANNUAL_PLAN_CODE=
PAYSTACK_PROFESSIONAL_MONTHLY_PLAN_CODE=
PAYSTACK_PROFESSIONAL_ANNUAL_PLAN_CODE=
PAYSTACK_ENTERPRISE_MONTHLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_ANNUAL_PLAN_CODE=
# Clinic Administrator activation. Use an HTTPS universal link when available,
# or the Flutter deep link shown here. Resend is optional; without it the
# Platform Owner receives a one-time manual delivery link after approval/resend.
ACTIVATION_TOKEN_TTL_MINUTES=1440
AVERA_ACTIVATION_BASE_URL=https://accounts.averavet.sbs/activate-clinic-admin
RESEND_API_KEY=
ACTIVATION_EMAIL_FROM=
LOG_LEVEL=info
